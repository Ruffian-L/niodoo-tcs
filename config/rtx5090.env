# NIODOO RTX 5090 runtime overrides - MAXIMUM GPU UTILIZATION
# RTX 5090 Blackwell architecture optimizations
USE_GPU_FITNESS=1
TCS_ENABLE_GPU=1
OPTIMIZED_ERAG=1
CACHE_PREFETCH_ENABLED=1
ERAG_BATCH_SIZE=512
ERAG_BATCH_FLUSH_MS=100
CACHE_PREFETCH_PROMPTS=32
CACHE_PREFETCH_TOP_HITS=16
CACHE_PREFETCH_PARALLELISM=16
GENERATION_MAX_TOKENS=8192
DYNAMIC_TOKEN_MAX=2048
TOKEN_PROMOTION_INTERVAL=20
ENABLE_CURATOR=1
CURATOR_BACKEND=vllm
HARDWARE=5090

# ONNX Runtime GPU memory limit for RTX 5090 (4GB for embeddings)
QWEN_CUDA_MEM_LIMIT_MB=4096

# vLLM tuning for RTX 5090 (32GB GDDR7)
VLLM_HOST=127.0.0.1
VLLM_PORT=5001
VLLM_ENDPOINT=http://127.0.0.1:5001
CURATOR_VLLM_ENDPOINT=http://127.0.0.1:5001
VLLM_MODEL_ID=/workspace/models/Qwen2.5-7B-Instruct-AWQ
VLLM_MODEL_PATH=/workspace/models/Qwen2.5-7B-Instruct-AWQ
VLLM_DTYPE=bfloat16
VLLM_GPU_MEMORY_UTILIZATION=0.95
VLLM_MAX_MODEL_LEN=128000
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_MAX_NUM_SEQS=128
VLLM_ATTENTION_BACKEND=FLASH_ATTN
VLLM_KV_CACHE_DTYPE=fp8
VLLM_USE_DEEP_GEMM=1
VLLM_ENABLE_CHUNKED_PREFILL=1
VLLM_ALL2ALL_BACKEND=pplx

# Runtime controls
RUSTONIG_SYSTEM_LIBONIG=1
LD_LIBRARY_PATH=/workspace/Niodoo-Final/third_party/onnxruntime-linux-x64-gpu-1.24.0/lib:/workspace/onnxruntime-linux-x64-gpu-1.24.0/lib:${LD_LIBRARY_PATH}

# Logging defaults
RUST_LOG=info

