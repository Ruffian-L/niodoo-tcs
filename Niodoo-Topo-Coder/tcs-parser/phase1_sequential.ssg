; phase1_sequential.ssg - Phase 1: Sequential statements only
; This declaratively solves the "what came before?" problem

; 1. Define nodes for statement types
(let_declaration) @stmt
{
  (node @stmt)
  (attr (@stmt) "kind" = "let_declaration")
}

(expression_statement) @stmt
{
  (node @stmt)
  (attr (@stmt) "kind" = "expression_statement")
}

; 2. Define sequential edges
; The '.' operator matches adjacent siblings
(block
  [
    (let_declaration) @stmt1
    (expression_statement) @stmt1
  ]
 .
  [
    (let_declaration) @stmt2
    (expression_statement) @stmt2
  ])
{
  (edge @stmt1 -> @stmt2)
  (attr (@stmt1 -> @stmt2) "kind" = "sequential")
}
