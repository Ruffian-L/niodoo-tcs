//! graph.rs - AST to Control Flow Graph conversion
//!
//! Converts tree-sitter AST into petgraph CFG with REAL EDGES.
//! NO STUBS. This creates a meaningful topology for persistent homology.

use tree_sitter::Tree;
use petgraph::graph::{DiGraph, NodeIndex};
use std::collections::HashMap;
use thiserror::Error;

/// Graph conversion errors
#[derive(Error, Debug)]
pub enum GraphError {
    #[error("Failed to load DSL file: {0}")]
    DslLoadFailed(String),

    #[error("Graph execution failed: {0}")]
    ExecutionFailed(String),

    #[error("Invalid node reference: {0}")]
    InvalidNode(String),
}

/// Node data in the control flow graph
#[derive(Debug, Clone)]
pub struct NodeData {
    /// Node type (function, call, if, loop, etc.)
    pub node_type: String,
    /// Optional node name/identifier
    pub name: Option<String>,
    /// Additional attributes from DSL
    pub attributes: HashMap<String, String>,
    /// AST node ID for edge creation
    pub ast_id: usize,
}

/// Edge data in the control flow graph
#[derive(Debug, Clone)]
pub struct EdgeData {
    /// Edge type (sequential, call, branch, loop, etc.)
    pub edge_type: String,
}

/// Control flow graph representation
pub type ControlFlowGraph = DiGraph<NodeData, EdgeData>;

/// Context for tracking nodes during AST walk
struct WalkContext {
    graph: ControlFlowGraph,
    /// Map AST node ID -> graph NodeIndex
    node_map: HashMap<usize, NodeIndex>,
    /// Track last statement in sequential blocks
    last_stmt: Option<NodeIndex>,
}

/// Converts a tree-sitter AST to a control flow graph
///
/// # Arguments
///
/// * `tree` - The parsed AST from tree-sitter
/// * `source_code` - The original source code (needed for extracting text)
///
/// # Returns
///
/// * `Ok(ControlFlowGraph)` - The extracted control flow graph WITH EDGES
/// * `Err(GraphError)` - If conversion fails
pub fn ast_to_graph(
    tree: &Tree,
    source_code: &str,
) -> Result<ControlFlowGraph, GraphError> {
    let mut ctx = WalkContext {
        graph: ControlFlowGraph::new(),
        node_map: HashMap::new(),
        last_stmt: None,
    };

    let root = tree.root_node();
    walk_node(&root, source_code, &mut ctx, None)?;

    Ok(ctx.graph)
}

/// Recursively walk AST and build CFG with real edges
fn walk_node(
    node: &tree_sitter::Node,
    source: &str,
    ctx: &mut WalkContext,
    parent_idx: Option<NodeIndex>,
) -> Result<Option<NodeIndex>, GraphError> {
    let kind = node.kind();
    let ast_id = node.id();

    // Create node and add to graph
    let current_idx = match kind {
        "function_item" => {
            let name = extract_function_name(node, source)?;
            let mut attrs = HashMap::new();
            attrs.insert("kind".to_string(), kind.to_string());
            
            let idx = ctx.graph.add_node(NodeData {
                node_type: "function".to_string(),
                name: Some(name),
                attributes: attrs,
                ast_id,
            });
            
            ctx.node_map.insert(ast_id, idx);
            Some(idx)
        }

        "call_expression" => {
            let mut attrs = HashMap::new();
            attrs.insert("kind".to_string(), kind.to_string());
            
            let idx = ctx.graph.add_node(NodeData {
                node_type: "call".to_string(),
                name: extract_call_name(node, source),
                attributes: attrs,
                ast_id,
            });
            
            ctx.node_map.insert(ast_id, idx);
            
            // EDGE: Connect call to parent (e.g., function or block)
            if let Some(parent) = parent_idx {
                ctx.graph.add_edge(parent, idx, EdgeData {
                    edge_type: "contains".to_string(),
                });
            }
            
            // EDGE: Sequential flow from previous statement
            if let Some(prev) = ctx.last_stmt {
                ctx.graph.add_edge(prev, idx, EdgeData {
                    edge_type: "sequential".to_string(),
                });
            }
            ctx.last_stmt = Some(idx);
            
            Some(idx)
        }

        "if_expression" => {
            let mut attrs = HashMap::new();
            attrs.insert("kind".to_string(), kind.to_string());
            
            let idx = ctx.graph.add_node(NodeData {
                node_type: "if".to_string(),
                name: None,
                attributes: attrs,
                ast_id,
            });
            
            ctx.node_map.insert(ast_id, idx);
            
            // EDGE: Sequential flow from previous statement
            if let Some(prev) = ctx.last_stmt {
                ctx.graph.add_edge(prev, idx, EdgeData {
                    edge_type: "sequential".to_string(),
                });
            }
            
            // EDGE: Branch to consequence and alternative
            for i in 0..node.child_count() {
                if let Some(child) = node.child(i) {
                    match child.kind() {
                        "block" if i == 2 => {
                            // Then branch (consequence)
                            if let Some(then_idx) = walk_node(&child, source, ctx, Some(idx))? {
                                ctx.graph.add_edge(idx, then_idx, EdgeData {
                                    edge_type: "then".to_string(),
                                });
                            }
                        }
                        "else_clause" => {
                            // Else branch
                            if let Some(else_block) = child.child(0) {
                                if let Some(else_idx) = walk_node(&else_block, source, ctx, Some(idx))? {
                                    ctx.graph.add_edge(idx, else_idx, EdgeData {
                                        edge_type: "else".to_string(),
                                    });
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            
            ctx.last_stmt = Some(idx);
            Some(idx)
        }

        "loop_expression" | "while_expression" | "for_expression" => {
            let mut attrs = HashMap::new();
            attrs.insert("kind".to_string(), kind.to_string());
            
            let idx = ctx.graph.add_node(NodeData {
                node_type: "loop".to_string(),
                name: None,
                attributes: attrs,
                ast_id,
            });
            
            ctx.node_map.insert(ast_id, idx);
            
            // EDGE: Sequential flow from previous statement
            if let Some(prev) = ctx.last_stmt {
                ctx.graph.add_edge(prev, idx, EdgeData {
                    edge_type: "sequential".to_string(),
                });
            }
            
            // EDGE: Loop body
            if let Some(body) = find_child_by_field(node, "body") {
                if let Some(body_idx) = walk_node(&body, source, ctx, Some(idx))? {
                    // Forward edge: loop -> body
                    ctx.graph.add_edge(idx, body_idx, EdgeData {
                        edge_type: "loop_entry".to_string(),
                    });
                    
                    // CRITICAL: Back edge creates cycle (β₁ detection!)
                    ctx.graph.add_edge(body_idx, idx, EdgeData {
                        edge_type: "loop_back".to_string(),
                    });
                }
            }
            
            ctx.last_stmt = Some(idx);
            Some(idx)
        }

        "match_expression" => {
            let mut attrs = HashMap::new();
            attrs.insert("kind".to_string(), kind.to_string());
            
            let idx = ctx.graph.add_node(NodeData {
                node_type: "match".to_string(),
                name: None,
                attributes: attrs,
                ast_id,
            });
            
            ctx.node_map.insert(ast_id, idx);
            
            // EDGE: Sequential flow
            if let Some(prev) = ctx.last_stmt {
                ctx.graph.add_edge(prev, idx, EdgeData {
                    edge_type: "sequential".to_string(),
                });
            }
            
            // EDGE: Connect to each match arm
            for i in 0..node.child_count() {
                if let Some(child) = node.child(i) {
                    if child.kind() == "match_arm" {
                        if let Some(arm_idx) = walk_node(&child, source, ctx, Some(idx))? {
                            ctx.graph.add_edge(idx, arm_idx, EdgeData {
                                edge_type: "match_arm".to_string(),
                            });
                        }
                    }
                }
            }
            
            ctx.last_stmt = Some(idx);
            Some(idx)
        }

        "block" => {
            // Block is a container - walk children sequentially
            let saved_last = ctx.last_stmt;
            ctx.last_stmt = None; // Reset for new block
            
            let mut block_entry: Option<NodeIndex> = None;
            
            for i in 0..node.child_count() {
                if let Some(child) = node.child(i) {
                    if child.kind() != "{" && child.kind() != "}" {
                        if let Some(stmt_idx) = walk_node(&child, source, ctx, parent_idx)? {
                            if block_entry.is_none() {
                                block_entry = Some(stmt_idx);
                            }
                        }
                    }
                }
            }
            
            ctx.last_stmt = saved_last; // Restore
            block_entry // Return first statement in block
        }

        _ => {
            // Recurse to children for unhandled node types
            for i in 0..node.child_count() {
                if let Some(child) = node.child(i) {
                    walk_node(&child, source, ctx, parent_idx)?;
                }
            }
            None
        }
    };

    Ok(current_idx)
}

/// Extract function name from function_item node
fn extract_function_name(node: &tree_sitter::Node, source: &str) -> Result<String, GraphError> {
    for i in 0..node.child_count() {
        if let Some(child) = node.child(i) {
            if child.kind() == "identifier" {
                return child.utf8_text(source.as_bytes())
                    .map(|s| s.to_string())
                    .map_err(|e| GraphError::ExecutionFailed(format!("UTF-8 error: {}", e)));
            }
        }
    }
    Ok("anonymous".to_string())
}

/// Extract call target name
fn extract_call_name(node: &tree_sitter::Node, source: &str) -> Option<String> {
    for i in 0..node.child_count() {
        if let Some(child) = node.child(i) {
            if child.kind() == "identifier" {
                return child.utf8_text(source.as_bytes())
                    .ok()
                    .map(|s| s.to_string());
            }
        }
    }
    None
}

/// Find child by field name
fn find_child_by_field<'a>(node: &'a tree_sitter::Node, field: &str) -> Option<tree_sitter::Node<'a>> {
    for i in 0..node.child_count() {
        if let Some(child) = node.child(i) {
            if node.field_name_for_child(i as u32) == Some(field) {
                return Some(child);
            }
        }
    }
    None
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::get_ast;

    #[test]
    fn test_simple_function_graph() {
        let code = "fn main() { let x = 42; }";
        let tree = get_ast(code, "rust").expect("Failed to parse");
        
        let graph = ast_to_graph(&tree, code).expect("Failed to build graph");
        
        // Should have at least one node (the main function)
        assert!(graph.node_count() >= 1);
        
        // Find the main function node
        let has_main = graph.node_weights().any(|n| {
            n.node_type == "function" && n.name.as_ref().map(|s| s.as_str()) == Some("main")
        });
        assert!(has_main, "Should have found main function");
    }

    #[test]
    fn test_edges_created() {
        let code = r#"
            fn test() {
                let x = 1;
                let y = 2;
            }
        "#;

        let tree = get_ast(code, "rust").expect("Failed to parse");
        let graph = ast_to_graph(&tree, code).expect("Failed to build graph");

        // CRITICAL: We should now have edges!
        assert!(graph.edge_count() > 0, "Graph should have edges connecting statements");
    }

    #[test]
    fn test_loop_creates_cycle() {
        let code = r#"
            fn test() {
                loop {
                    println!("hi");
                }
            }
        "#;

        let tree = get_ast(code, "rust").expect("Failed to parse");
        let graph = ast_to_graph(&tree, code).expect("Failed to build graph");

        // Should have loop node + body node
        assert!(graph.node_count() >= 2);
        
        // Should have forward edge + back edge (cycle!)
        assert!(graph.edge_count() >= 2, "Loop should create forward and back edges");
        
        // Check for cycle: β₁ > 0
        let has_loop_node = graph.node_weights().any(|n| n.node_type == "loop");
        assert!(has_loop_node, "Should have loop node");
    }

    #[test]
    fn test_if_creates_branches() {
        let code = r#"
            fn test() {
                if true {
                    println!("yes");
                } else {
                    println!("no");
                }
            }
        "#;

        let tree = get_ast(code, "rust").expect("Failed to parse");
        let graph = ast_to_graph(&tree, code).expect("Failed to build graph");

        // Should have if node + branches
        assert!(graph.node_count() >= 2);
        assert!(graph.edge_count() >= 2, "If should create then/else edges");
    }

    #[test]
    fn test_complex_factorial() {
        let code = r#"
            fn factorial(n: u32) -> u32 {
                if n == 0 {
                    1
                } else {
                    n * factorial(n - 1)
                }
            }
        "#;

        let tree = get_ast(code, "rust").expect("Failed to parse");
        let graph = ast_to_graph(&tree, code).expect("Failed to build graph");

        // Should have function, if, and call nodes
        assert!(graph.node_count() >= 3);
        
        // CRITICAL: Should have REAL edges now
        assert!(graph.edge_count() > 0, "Complex graph should have control flow edges");

        let has_factorial = graph.node_weights().any(|n| {
            n.node_type == "function" && n.name.as_ref().map(|s| s.as_str()) == Some("factorial")
        });
        assert!(has_factorial);

        let has_if = graph.node_weights().any(|n| n.node_type == "if");
        assert!(has_if);

        let has_call = graph.node_weights().any(|n| n.node_type == "call");
        assert!(has_call);
    }
}

#[cfg(test)]
mod debug_tests {
    use super::*;
    use crate::get_ast;

    #[test]
    fn debug_ast_structure() {
        let code = r#
