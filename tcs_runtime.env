# Core service endpoints
VLLM_HOST=127.0.0.1
VLLM_PORT=5001
VLLM_ENDPOINT=http://127.0.0.1:5001
CURATOR_VLLM_ENDPOINT=http://127.0.0.1:5001
OLLAMA_ENDPOINT=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.aNhxn0SNx6GEmxk2swvkZdM8EC10fWE8hsWSKLIOXyc

# Model and tokenizer configuration
# You can also set RuntimeConfig.tokenizer_json if you prefer to bake the path into the config file.
TOKENIZER_JSON=/workspace/Niodoo-Final/tokenizer.json
NIODOO_ROOT=/workspace/Niodoo-Final
QDRANT_COLLECTION=experiences
QDRANT_USE_GRPC=false

# vLLM generation defaults for NVIDIA H200 (141GB HBM3e)
VLLM_MODEL_ID=/workspace/models/Qwen3-Coder
VLLM_MODEL_PATH=/workspace/models/Qwen3-Coder
VLLM_DTYPE=bfloat16
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=64
VLLM_ATTENTION_BACKEND=FLASH_ATTN
VLLM_KV_CACHE_DTYPE=fp8
VLLM_USE_DEEP_GEMM=1
VLLM_ENABLE_CHUNKED_PREFILL=1
VLLM_ALL2ALL_BACKEND=pplx

# Runtime controls
RUSTONIG_SYSTEM_LIBONIG=1
LD_LIBRARY_PATH=/workspace/Niodoo-Final/third_party/onnxruntime-linux-x64-gpu-1.24.0/lib:/workspace/onnxruntime-linux-x64-gpu-1.24.0/lib

# Logging defaults
RUST_LOG=info
