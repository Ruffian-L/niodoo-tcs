# Niodoo-TCS Runtime Configuration (YAML format)
# Dual vLLM setup with ONNX embeddings

# ===== vLLM Endpoints =====
vllm_endpoint: http://127.0.0.1:5002
vllm_model: /workspace/Niodoo-AI/outputs/qwen25-coder-topology-20251105/merged

# ===== Qdrant Configuration =====
qdrant_url: http://127.0.0.1:6333
qdrant_collection: experiences
qdrant_vector_dim: 896
qdrant_embedded: false
qdrant_quantization: null

# ===== Ollama Configuration =====
ollama_endpoint: http://127.0.0.1:11434
embedding_model_name: nomic-embed-text
embedding_max_chars: 2048
embed_with_candle: false
embed_model_dir: null

# ===== ONNX Runtime Configuration =====
qwen_model_path: /workspace/models/hf_cache/models--onnx-community--Qwen2.5-Coder-0.5B-Instruct/snapshots/f0292f665fd307846ff3c318a91a1bc29d091492/onnx/model.onnx
tokenizer_json: /workspace/models/Qwen2-0.5B-Instruct/tokenizer.json
# Note: LD_LIBRARY_PATH should be set in environment, not in YAML config
# LD_LIBRARY_PATH=/workspace/onnxruntime-linux-x64-gpu-1.18.1/lib

# ===== Data Paths =====
training_data_path: /workspace/Niodoo-Final/data/training_data.json
emotional_seed_path: /workspace/Niodoo-Final/data/emotional_seeds.json
rut_gauntlet_path: /workspace/Niodoo-Final/data/rut_gauntlet.txt

# ===== Topology Configuration =====
topology_mode: hybrid
mock_mode: false
entropy_cycles_for_baseline: 5
enable_consistency_voting: false

# ===== RCE (Recursive Connectome Engine) =====
rce_enabled: true
rce_shadow_mode: true
rce_actions_enabled: false
rce_window_seconds: 10
rce_stride_seconds: 2
rce_breakthrough_threshold: 0.5
rce_erag_lambda: 0.0
rce_archive_backend: Qdrant

rce_beta_meta_weights:
  alpha_betti: 1.0
  alpha_meta: 1.0
  alpha_motif: 1.0
  alpha_sheaf: 1.0

rce_consensus:
  enabled: false
  analyzers: 0
  quorum: 0

# ===== Phase 2 Retry Configuration =====
phase2_max_retries: 3
phase2_retry_base_delay_ms: 100
phase2_cot_iterations: 1
phase2_retry_backoff_cap_ms: 1500
similarity_threshold: 0.5
phase2_level3_retry_count: 2
phase2_mcts_c_increment: 0.1
phase2_top_p_increment: 0.05
phase2_retrieval_top_k_increment: 2

# ===== Generation Backend =====
generation_backend: vllm_gpu

# ===== Curator Configuration =====
enable_curator: true
curator_model_name: qwen2:0.5b
curator_quality_threshold: 0.6
curator_minimum_threshold: 0.4
curator_timeout_secs: 30
curator_temperature: 0.7
curator_max_tokens: 512
curator_autonomous: true
assessment_prompt_template: "Assess the quality of this response on a scale of 0.0 to 1.0:"

# ===== Generation Parameters =====
generation_timeout_secs: 60
generation_max_tokens: 512
dynamic_token_min: 128
dynamic_token_max: 1024
temperature: 0.7
top_p: 0.9
repetition_penalty: 1.2
system_prompt: You are a helpful AI assistant.

# ===== DQN Learning Parameters =====
dqn_epsilon: 0.9
dqn_gamma: 0.99
dqn_alpha: 0.1
learning_window: 10
breakthrough_threshold: 0.2
breakthrough_rouge_min: 0.65
novelty_threshold: 0.5
self_awareness_level: 0.3

dqn_actions: []

# ===== Prompt and Token Configuration =====
prompt_max_chars: 512
token_promotion_interval: 100

# ===== Cache Configuration =====
embedding_cache_ttl_secs: 10
collapse_cache_ttl_secs: 30
cache_capacity: 256
cache_compression_min_bytes: 2048
cache_prefetch_enabled: true
cache_prefetch_prompts: 8
cache_prefetch_top_hits: 3
cache_prefetch_parallelism: 2

# ===== Training Data =====
training_data_sample_cap: 20000
rng_seed: 42
consistency_variance_threshold: 0.15

# ===== Sampling Parameters =====
lens_snippet_chars: 180
cot_temp_increment: 0.1
reflexion_top_p_step: 0.05
cot_success_rouge_threshold: 0.5

# ===== Variance Thresholds =====
variance_stagnation_default: 0.05
variance_spike_min: 0.3
mirage_sigma_factor: 0.1
mcts_c_min_std: 0.1
mcts_c_scale: 0.25

# ===== Retry Configuration =====
retry_backoff_exponent_cap: 10

# ===== Memory Configuration =====
disable_memory_store: false

weighted_memory_config:
  enabled: true
  decay_rate: 0.95
  min_weight: 0.1
  max_entries: 1000

# ===== Resource Budget =====
resource_budget_config:
  enabled: false
  max_memory_mb: 8192
  max_gpu_utilization: 0.9
  max_concurrent_requests: 10

# ===== Degradation Configuration =====
degradation_config:
  enabled: false
  quality_threshold: 0.5
  reduce_batch_size: true
  reduce_max_tokens: true

# ===== Temporal TDA Configuration =====
temporal_tda_config:
  enabled: true
  window_size: 100
  stride: 10
  max_dimension: 2

# ===== Security Configuration =====
security:
  rate_limit_window_secs: 60
  rate_limit_max_requests: 45
  allow_control_chars: false
  banned_patterns:
    - '(?i)\b(?:drop|delete)\s+(?:table|database)\b'
    - '(?i)\bunion\s+select\b'
    - '(?i)<script'
    - '(?i)\brm\s+-rf\s+/'
  audit_log_path: ./logs/security_audit.log
  prompt_max_chars: 512

# ===== Pipeline Optimizations =====
optimized_erag: true
erag_batch_size: 32
erag_batch_flush_ms: 100
use_approximate_tda: false
fp16_qlora_adapters: true
parallel_curator_rouge: true
use_gpu_fitness: false

# ===== Ablation Testing =====
erag_bypass: false
n_tokens_bypass: false

# ===== Curator Feedback Configuration =====
curator_feedback_window_size: 10
curator_feedback_threshold_adjustment: 0.05
curator_feedback_threshold_min: 0.3
curator_feedback_threshold_max: 0.9
curator_feedback_quality_trend_threshold: 0.1
curator_feedback_temp_adjustment_multiplier: 1.1
curator_feedback_learned_rate_low: 0.3
curator_feedback_quality_low: 0.5
curator_feedback_top_p_increase: 0.05
curator_feedback_learned_rate_high: 0.7
curator_feedback_quality_high: 0.6
curator_feedback_top_p_decrease: 0.05
curator_feedback_retrieval_quality_threshold: 0.5
curator_feedback_retrieval_top_k_increase: 2.0
